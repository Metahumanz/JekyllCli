<Page x:Class="BlogTools.AppSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:BlogTools.Helpers"
      xmlns:icons="clr-namespace:BlogTools.Icons"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{DynamicResource NavAppSettings}">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainContent" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8" />
                    <ThicknessAnimation Storyboard.TargetName="MainContent" Storyboard.TargetProperty="Margin" From="0,40,0,0" To="16" Duration="0:0:0.8">
                        <ThicknessAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid Margin="16" x:Name="MainContent" Opacity="0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <icons:AssetIcon Kind="Settings" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <StackPanel>
                <TextBlock Text="{DynamicResource AppSettingsTitle}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource AppSettingsSub}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <ui:InfoBar Grid.Row="1" x:Name="StatusInfo" IsOpen="False" Message="" Severity="Success" Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="2"
                      x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      Focusable="False"
                      PreviewMouseWheel="PageScrollViewer_PreviewMouseWheel"
                      helpers:SmoothScrollHelper.SmoothingEnabled="True">
            <StackPanel Background="Transparent" Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource SettingsSecWorkspace}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:CardControl Margin="0,0,0,24" Icon="{icons:AssetIcon Folder}" Style="{StaticResource RoundedCardControlStyle}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsLabelBlogPath}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="CurrentPathBlock" Text="C:\..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{DynamicResource SettingsBtnChangePath}" Style="{StaticResource LiftedUiButtonStyle}" Click="ChangeBlogPath_Click" />
                </ui:CardControl>

                <TextBlock Text="{DynamicResource SettingsSecDrafting}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Margin="0,0,0,24">
                    <ui:CardControl Margin="0,0,0,4" Icon="{icons:AssetIcon Document}" Style="{StaticResource RoundedCardControlStyle}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLabelRememberMetadata}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource SettingsDescRememberMetadata}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="RememberMetadataToggle" Checked="RememberMetadata_Checked" Unchecked="RememberMetadata_Unchecked" />
                    </ui:CardControl>

                    <ui:CardControl Margin="0,0,0,4" Icon="{icons:AssetIcon Toolbox}" Style="{StaticResource RoundedCardControlStyle}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLabelKeepToolboxToolWhenPinned}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource SettingsDescKeepToolboxToolWhenPinned}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="KeepToolboxToolWhenPinnedToggle" Checked="KeepToolboxToolWhenPinned_Checked" Unchecked="KeepToolboxToolWhenPinned_Unchecked" />
                    </ui:CardControl>

                    <ui:CardControl Margin="0,0,0,0" Icon="{icons:AssetIcon Clock}" Style="{StaticResource RoundedCardControlStyle}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLabelAutoUpdateMod}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource SettingsDescAutoUpdateMod}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AutoUpdateModifiedTimeToggle" Checked="AutoUpdateModifiedTime_Checked" Unchecked="AutoUpdateModifiedTime_Unchecked" />
                    </ui:CardControl>
                </StackPanel>

                <TextBlock Text="{DynamicResource SettingsSecAppearance}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Margin="0,0,0,24">
                    <ui:CardControl Margin="0,0,0,4" Icon="{icons:AssetIcon Theme}" Style="{StaticResource RoundedCardControlStyle}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLabelDarkMode}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource SettingsDescDarkMode}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="ThemeModeComboBox" Width="200" SelectionChanged="ThemeModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource SettingsThemeModeAuto}" Tag="Auto"/>
                            <ComboBoxItem Content="{DynamicResource SettingsThemeModeDark}" Tag="Dark"/>
                            <ComboBoxItem Content="{DynamicResource SettingsThemeModeLight}" Tag="Light"/>
                        </ComboBox>
                    </ui:CardControl>

                    <ui:CardControl Margin="0,0,0,4" Icon="{icons:AssetIcon Globe}" Style="{StaticResource RoundedCardControlStyle}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLabelLanguage}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource SettingsDescLanguage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="LanguageComboBox" Width="200" SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="跟随系统 (Auto)" Tag="Auto"/>
                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                        </ComboBox>
                    </ui:CardControl>

                    <ui:CardControl Margin="0,0,0,0" Icon="{icons:AssetIcon Font}" Style="{StaticResource RoundedCardControlStyle}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLabelFont}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource SettingsDescFont}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="FontComboBox"
                                  Width="200"
                                  MaxDropDownHeight="300"
                                  IsTextSearchEnabled="True"
                                  SelectionChanged="FontComboBox_SelectionChanged"
                                  helpers:SmoothScrollHelper.SmoothingEnabled="True"
                                  ScrollViewer.CanContentScroll="False"/>
                    </ui:CardControl>
                </StackPanel>

                <TextBlock Text="{DynamicResource SettingsSecUpdates}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Margin="0,0,0,24">
                    <ui:CardControl Margin="0,0,0,4" Icon="{icons:AssetIcon CloudDownload}" Style="{StaticResource RoundedCardControlStyle}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLabelCheckUpdate}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="VersionBlock" Text="..." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="CheckUpdateButton" Style="{StaticResource LiftedUiButtonStyle}" Content="{DynamicResource SettingsBtnCheckUpdate}" Click="CheckUpdate_Click" />
                    </ui:CardControl>

                    <ui:CardControl Margin="0,0,0,4" Icon="{icons:AssetIcon Refresh}" Style="{StaticResource RoundedCardControlStyle}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLabelSilentUpdate}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{DynamicResource SettingsDescSilentUpdate}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="SilentUpdateToggle" Checked="SilentUpdate_Checked" Unchecked="SilentUpdate_Unchecked" />
                    </ui:CardControl>

                    <ui:CardAction Margin="0,0,0,4" Icon="{ui:SymbolIcon Symbol=Star24}" Command="{Binding Path=.}" Click="OpenGithubStar_Click">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsLabelStar}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{DynamicResource SettingsDescStar}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </ui:CardAction>

                    <Border x:Name="ProgressPanel" Visibility="Collapsed"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource AppCardCornerRadius}" Padding="16" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ProgressText" Text="{DynamicResource SettingsMsgProgressPreparing}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Value="0" Height="6" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ AI 提交信息 ═══ -->
                <TextBlock Text="{DynamicResource SettingsSecAiCommit}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource AppCardCornerRadius}" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Profile selector row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelProfile}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AiProfileComboBox" Grid.Column="2"
                                      IsEditable="True" IsTextSearchEnabled="False"
                                      SelectionChanged="AiProfile_SelectionChanged"
                                      PreviewKeyDown="AiProfileComboBox_PreviewKeyDown"
                                      LostKeyboardFocus="AiProfileComboBox_LostKeyboardFocus"/>
                            <ui:Button x:Name="AiAddProfileBtn" Grid.Column="4" Content="+" Width="32" Height="28" Padding="0"
                                       Style="{StaticResource LiftedUiButtonStyle}" Click="AiAddProfile_Click" ToolTip="{DynamicResource AiCommitTooltipAddProfile}"/>
                            <ui:Button x:Name="AiRenameProfileBtn" Grid.Column="6" Content="{DynamicResource AiCommitBtnRename}" Height="28" Padding="8,2"
                                       Style="{StaticResource LiftedUiButtonStyle}" Click="AiRenameProfile_Click" ToolTip="{DynamicResource AiCommitTooltipRenameProfile}"/>
                            <ui:Button x:Name="AiDeleteProfileBtn" Grid.Column="8" Content="{DynamicResource AiCommitBtnDelete}" Height="28" Padding="8,2"
                                       Style="{StaticResource LiftedUiButtonStyle}" Click="AiDeleteProfile_Click" ToolTip="{DynamicResource AiCommitTooltipDeleteProfile}"/>
                        </Grid>

                        <!-- Provider -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelProvider}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AiProviderComboBox" Grid.Column="2" SelectionChanged="AiProvider_SelectionChanged"/>
                        </Grid>

                        <!-- Base URL -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelBaseUrl}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox x:Name="AiBaseUrlBox" Grid.Column="2" PlaceholderText="https://api.openai.com/v1"/>
                        </Grid>

                        <!-- Model + Refresh -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelModel}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AiModelBox" Grid.Column="2" IsEditable="True" IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"/>
                            <ui:Button x:Name="AiRefreshModelsBtn" Grid.Column="4" Content="{DynamicResource AiCommitBtnRefreshModels}" Height="28" Padding="8,2"
                                       Style="{StaticResource LiftedUiButtonStyle}" Click="AiRefreshModels_Click" ToolTip="{DynamicResource AiCommitTooltipRefreshModels}"/>
                        </Grid>

                        <!-- Optional model list URL -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelModelsUrl}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBox x:Name="AiModelsUrlBox" Grid.Column="2"
                                        PlaceholderText="{DynamicResource AiCommitPlaceholderModelsUrl}"/>
                        </Grid>

                        <!-- API Key -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelApiKey}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <PasswordBox x:Name="AiApiKeyPasswordBox" Grid.Column="2" Padding="8,4"
                                         PasswordChanged="AiApiKeyPasswordBox_PasswordChanged"/>
                            <ui:TextBox x:Name="AiApiKeyVisibleBox" Grid.Column="2" Visibility="Collapsed"
                                        PlaceholderText="sk-..." TextChanged="AiApiKeyVisibleBox_TextChanged"/>
                            <CheckBox x:Name="AiShowApiKeyCheckBox" Grid.Column="4" VerticalAlignment="Center"
                                      Content="{DynamicResource AiCommitLabelShowApiKey}"
                                      Checked="AiShowApiKey_Changed" Unchecked="AiShowApiKey_Changed"/>
                        </Grid>

                        <!-- Deprecation warning -->
                        <ui:InfoBar x:Name="AiDeprecationInfo" IsOpen="False" Severity="Warning" Margin="0,0,0,10"
                                    Title="{DynamicResource AiCommitMsgDeprecatedTitle}"
                                    Message="{DynamicResource AiCommitMsgDeprecatedMsg}"/>

                        <!-- Suggested models -->
                        <WrapPanel x:Name="AiSuggestedModelsPanel" Margin="0,0,0,10" Visibility="Collapsed"/>

                        <!-- Action buttons row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:Button x:Name="AiSaveProfileBtn" Content="{DynamicResource AiCommitBtnSaveProfile}"
                                       Style="{StaticResource LiftedUiButtonStyle}" Appearance="Primary" Click="AiSaveProfile_Click"
                                       Icon="{icons:AssetIcon Save}" Margin="0,0,8,0" Padding="12,6"/>
                            <ui:Button x:Name="AiTestGenerateBtn" Content="{DynamicResource AiCommitBtnTestGenerate}"
                                       Style="{StaticResource LiftedUiButtonStyle}" Click="AiTestGenerate_Click"
                                       Icon="{icons:AssetIcon Megaphone}" Margin="0,0,8,0" Padding="12,6"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,4,0,12"/>

                        <!-- Commit style -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelStyle}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AiCommitStyleComboBox" Grid.Column="2" SelectionChanged="AiCommitStyle_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource AiCommitStyleSingleLine}" Tag="SingleLine"/>
                                <ComboBoxItem Content="{DynamicResource AiCommitStyleConventional}" Tag="ConventionalCommit"/>
                            </ComboBox>
                        </Grid>

                        <!-- Output language -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelLanguage}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AiLanguageComboBox" Grid.Column="2" SelectionChanged="AiLanguage_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource AiCommitLangFollowUI}" Tag="FollowUI"/>
                                <ComboBoxItem Content="{DynamicResource AiCommitLangChinese}" Tag="Chinese"/>
                                <ComboBoxItem Content="{DynamicResource AiCommitLangEnglish}" Tag="English"/>
                            </ComboBox>
                        </Grid>

                        <!-- Publish behavior -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AiCommitLabelBehavior}" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AiBehaviorComboBox" Grid.Column="2" SelectionChanged="AiBehavior_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource AiCommitBehaviorConfirm}" Tag="ConfirmAndEdit"/>
                                <ComboBoxItem Content="{DynamicResource AiCommitBehaviorDirect}" Tag="DirectCommit"/>
                            </ComboBox>
                        </Grid>

                        <!-- Per-context toggles -->
                        <ui:CardControl Margin="0,0,0,4" Icon="{icons:AssetIcon Edit}" Style="{StaticResource RoundedCardControlStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AiCommitLabelPostsToggle}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource AiCommitDescPostsToggle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AiCommitPostsToggle" Checked="AiCommitPosts_Checked" Unchecked="AiCommitPosts_Unchecked"/>
                        </ui:CardControl>
                        <ui:CardControl Margin="0,0,0,4" Icon="{icons:AssetIcon Globe}" Style="{StaticResource RoundedCardControlStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AiCommitLabelSettingsToggle}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource AiCommitDescSettingsToggle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AiCommitSettingsToggle" Checked="AiCommitSettings_Checked" Unchecked="AiCommitSettings_Unchecked"/>
                        </ui:CardControl>

                        <!-- Refresh status -->
                        <TextBlock x:Name="AiStatusText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
